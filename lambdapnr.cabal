cabal-version:      3.0
name:               lambdapnr
version:            0.1.0.0
synopsis:           lambdapnr — a Haskell FPGA place-and-route tool
description:
  Bit-compatible reimplementation of the nextpnr kernel and algorithms in
  Haskell, targeting maximum parallelism and high performance. See
  SPECIFICATION.md for the architecture extraction and port design.
license:            ISC
author:             nextpnr-haskell contributors
maintainer:         nextpnr-haskell contributors
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wmissing-export-lists
               -Wpartial-fields -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Lambdapnr.Arch.Ecp5
    Lambdapnr.Arch.Ecp5.Chipdb
    Lambdapnr.Arch.Ecp5.ConstIds
    Lambdapnr.Arch.Ecp5.Types
    Lambdapnr.Kernel.Arch
    Lambdapnr.Kernel.Checksum
    Lambdapnr.Kernel.Context
    Lambdapnr.Kernel.Delay
    Lambdapnr.Kernel.DeterministicRng
    Lambdapnr.Kernel.HashTable
    Lambdapnr.Kernel.IdString
    Lambdapnr.Kernel.Netlist
    Lambdapnr.Kernel.Property
  build-depends:
    base >=4.17 && <5,
    bytestring,
    containers,
    text,
    vector
  data-files:
    data/ecp5/chipdb-25k.bin
  default-language: Haskell2010

executable lambdapnr
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base,
    lambdapnr,
    text
  default-language: Haskell2010

test-suite lambdapnr-test
  import:           warnings
  type:             exitcode-stdio-1.0
  -- -M2G: hard heap cap so a regression can never OOM the machine again
  -- (the parser used to allocate tens of GB from a corrupt slice count)
  ghc-options:      -rtsopts -with-rtsopts=-M2G
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    ZzProbeTest
    Lambdapnr.Arch.Ecp5Test
    Lambdapnr.Kernel.ChecksumTest
    Lambdapnr.Kernel.DelayTest
    Lambdapnr.Kernel.DeterministicRngTest
    Lambdapnr.Kernel.IdStringTest
    Lambdapnr.Kernel.NetlistTest
    Lambdapnr.Kernel.PropertyTest
  build-depends:
    base,
    bytestring,
    containers,
    lambdapnr,
    tasty,
    tasty-hunit,
    text,
    vector
  default-language: Haskell2010
